<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dynamic Title -->
        <TextView
            android:id="@+id/signupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mentorship Signup"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="20dp"/>

        <!-- Bio -->
        <EditText
            android:id="@+id/bioEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Short Bio"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="16dp"/>

        <!-- Major -->
        <EditText
            android:id="@+id/majorEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Major"
            android:layout_marginBottom="16dp"/>

        <!-- Year -->
        <Spinner
            android:id="@+id/yearSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <!-- Topics -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mentorship Topics"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/topicChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            app:selectionRequired="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCampusLife"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Campus Life"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAcademics"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Academics"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipClubs"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clubs"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTimeManagement"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time Management"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCommuter"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commuter Adjustment"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTransfer"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer Adjustment"/>

        </com.google.android.material.chip.ChipGroup>

        <!-- Checkboxes -->
        <CheckBox
            android:id="@+id/commuterCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I am a commuter student"
            android:layout_marginTop="20dp"/>

        <CheckBox
            android:id="@+id/transferCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I am a transfer student"/>

        <!-- Submit -->
        <Button
            android:id="@+id/signupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:backgroundTint="#ACD1AF"
            android:layout_marginTop="24dp"/>

        <!-- Cancel Enrollment -->
        <Button
            android:id="@+id/cancelSignupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel Mentorship Enrollment"
            android:textColor="#B00020"
            android:backgroundTint="#9E9E9E"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>