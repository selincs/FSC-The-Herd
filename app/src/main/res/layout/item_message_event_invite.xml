<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_margin="8dp"
    android:background="@drawable/bg_message_received">

    <!-- Invite Header -->
    <TextView
        android:id="@+id/tvInviteHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉 Event Invite"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <!-- Event Name -->
    <TextView
        android:id="@+id/tvInviteEventName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Event Name"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingBottom="4dp"/>

    <!-- Event Date -->
    <TextView
        android:id="@+id/tvInviteEventDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="May 22, 2026"
        android:paddingBottom="2dp"/>

    <!-- Event Time -->
    <TextView
        android:id="@+id/tvInviteEventTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8:00 PM"
        android:paddingBottom="2dp"/>

    <!-- Event Location -->
    <TextView
        android:id="@+id/tvInviteEventLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selin's House"
        android:paddingBottom="10dp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRsvpInvite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="RSVP"/>
    </LinearLayout>

</LinearLayout>