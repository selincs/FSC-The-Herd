<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create a New Goal"
        android:textColor="#2F442F"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/inputActivityName"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="What is your goal? (e.g. Read 10 pages)"
        android:background="#F8F9FA"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:inputType="textCapSentences"/>

    <EditText
        android:id="@+id/inputPartnerName"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Who is your partner? (Optional)"
        android:background="#F8F9FA"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="32dp"
        android:inputType="textCapWords"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveCommitment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Tracking"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#779A77"
        app:cornerRadius="12dp" />

</LinearLayout>